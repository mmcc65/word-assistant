<Window x:Class="Cet6WordAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="生词助手"
        Icon="word.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F2">
  <Grid>
    <Border x:Name="LoadingPanel" Background="#F5F6F2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64" Height="64" Background="#173F35" CornerRadius="16">
          <TextBlock Text="词" Foreground="#F7F8F5" FontSize="36" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Margin="0,18,0,0" Text="正在打开生词助手……" Foreground="#52655C" FontSize="14" />
      </StackPanel>
    </Border>
    <wv2:WebView2 x:Name="Browser" Visibility="Hidden" />
  </Grid>
</Window>
