# 可选：Supabase 云同步。前端只能使用 Publishable Key（或旧版 anon key）。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 可选：词典代理服务。不要把付费词典密钥放进 VITE_ 变量。
VITE_DICTIONARY_PROXY_URL=

# 可选：版本清单地址；留空时读取站点根目录 /version.json。
VITE_UPDATE_MANIFEST_URL=

# 可选：Azure Neural TTS 代理。密钥必须由服务端代理保存，不能写入前端。
VITE_TTS_PROXY_URL=
